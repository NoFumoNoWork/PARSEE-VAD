# PARSEE-VAD environment template.
# Copy to `.env` for your own bookkeeping or export these variables in the shell.
# The repository does not automatically load `.env` files.

# Local Qwen3.5-9B model directory.
PARSEE_QWEN35_9B_PATH=/path/to/Qwen3.5-9B

# Raw benchmark roots. Manifests should store video paths relative to these roots.
PARSEE_UCF_ROOT=/path/to/UCF-Crime
PARSEE_MSAD_ROOT=/path/to/MSAD
PARSEE_XD_ROOT=/path/to/XD-Violence
PARSEE_UBNORMAL_ROOT=/path/to/UBnormal

# Official annotation inputs used by scripts/evaluate.py.
# UCF GT manifest: columns include video,total_frames,original_intervals.
PARSEE_UCF_GT_MANIFEST=/path/to/ucf_official_gt_manifest.csv
# MSAD metadata manifest: columns include video,frame_count.
PARSEE_MSAD_GT_MANIFEST=/path/to/msad_test_manifest.csv
# MSAD anomaly CSV: columns include name,starting frame of anomaly,ending frame of anomaly.
PARSEE_MSAD_ANNOTATION_CSV=/path/to/msad_anomaly_annotation.csv
# XD-Violence official test annotation txt.
PARSEE_XD_ANNOTATION_TXT=/path/to/xd_test_annotations.txt

TOKENIZERS_PARALLELISM=false

# Optional paths for scripts/serve_parsee_fig4_viewer.py.
PARSEE_MSAD_ANOMALY_ROOT=/path/to/MSAD/anomaly/videos
PARSEE_MSAD_NORMAL_ROOT=/path/to/MSAD/normal/videos
PARSEE_UCF_ANNOTATION_TXT=/path/to/UCF-Crime/Temporal_Anomaly_Annotation_for_Testing_Videos.txt
